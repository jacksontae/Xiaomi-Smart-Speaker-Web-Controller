# Copy to .env next to docker-compose.yml, fill in, and keep it out of git (chmod 600).
PUBLIC_BASE_URL=https://speaker.example.com
MQTT_USERNAME=speaker-service
MQTT_PASSWORD=change-me
MQTT_BASE_TOPIC=speaker-relay/speaker-relay
MQTT_CLIENT_ID=speaker-service
CLOUDFLARE_TUNNEL_TOKEN=change-me
# Optional: nightly backup time (HH:MM, UTC) and how many backups to keep
BACKUP_TIME=03:30
BACKUP_KEEP=14
