# Home / LAN setup (compose.yaml). Copy to .env in the repository root; it is git-ignored.
# The address the speaker fetches audio from: this computer's LAN IP (give it a fixed DHCP lease in the
# router) and SPEAKER_PORT. Not localhost, and not the container's own address.
PUBLIC_BASE_URL=http://192.0.2.20:8090
# Port published on this computer (inside the container the service always listens on 8090)
SPEAKER_PORT=8090
# Time zone for schedules
TZ=Asia/Bangkok
# Optional: nightly backup time (HH:MM, UTC) and how many backups to keep in ./backups
BACKUP_TIME=03:30
BACKUP_KEEP=14
